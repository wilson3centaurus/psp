<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Teacher | PSP</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/assets/logo.png">
</head>
<body class="form-page">
  <div class="form-page-container">
    <div class="form-page-header">
      <a href="/teacher" class="back-btn"><i class="fas fa-arrow-left"></i></a>
      <h1><i class="fas fa-user-plus"></i> Add New Teacher</h1>
      <button class="theme-toggle" aria-label="Toggle theme">
        <i class="fas fa-moon"></i>
        <i class="fas fa-sun"></i>
      </button>
    </div>

    <% if (typeof success_msg !== 'undefined' && success_msg && String(success_msg).trim() !== "") { %>
      <div class="alert success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg && String(error_msg).trim() !== "") { %>
      <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
    <% } %>

    <div class="card form-card">
      <form action="/teacher/add" method="POST" id="addTeacherForm" novalidate>

        <div class="form-group">
          <label for="name"><i class="fas fa-user"></i> Full Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-input"
            placeholder="e.g. Mr. John Banda" required minlength="2" maxlength="100"
            pattern="[A-Za-z\s'\-\.]+" autocomplete="off">
          <small class="form-hint">Letters, spaces, hyphens, and apostrophes only.</small>
          <span class="field-error" id="err-name"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="subject"><i class="fas fa-book"></i> Subject <span class="required">*</span></label>
            <select id="subject" name="subject" class="form-input" required>
              <option value="">Select Subject</option>
              <option value="Mathematics">Mathematics</option>
              <option value="English">English</option>
              <option value="Chishona">Chishona</option>
              <option value="Social Science">Social Science</option>
              <option value="Physical Education and Arts">Physical Education and Arts</option>
              <option value="Science and Technology">Science and Technology</option>
            </select>
            <span class="field-error" id="err-subject"></span>
          </div>
          <div class="form-group">
            <label for="gender"><i class="fas fa-venus-mars"></i> Gender <span class="required">*</span></label>
            <select id="gender" name="gender" class="form-input" required>
              <option value="">Select Gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
            <span class="field-error" id="err-gender"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="phone"><i class="fas fa-phone"></i> Phone <span class="optional-label">(optional)</span></label>
            <input type="tel" id="phone" name="phone" class="form-input"
              placeholder="e.g. 0712345678" maxlength="10">
            <small class="form-hint">Exactly 10 digits (e.g. 0712345678)</small>
            <span class="field-error" id="err-phone"></span>
          </div>
          <div class="form-group">
            <label for="email"><i class="fas fa-envelope"></i> Email <span class="optional-label">(optional)</span></label>
            <input type="email" id="email" name="email" class="form-input"
              placeholder="e.g. teacher@school.ac.zw" maxlength="100">
            <span class="field-error" id="err-email"></span>
          </div>
        </div>

        <div class="form-group">
          <label for="teacher_id"><i class="fas fa-id-badge"></i> EC Number <span class="required">*</span></label>
          <input type="text" id="teacher_id" name="teacher_id" class="form-input"
            placeholder="e.g. 1234567G" required maxlength="8" autocomplete="off">
          <small class="form-hint"><i class="fas fa-info-circle"></i> 7 digits + 1 letter (e.g. 1234567G)</small>
          <span class="field-error" id="err-ec"></span>
        </div>

        <h3 class="form-section-title" style="margin-top:1.5rem;"><i class="fas fa-camera"></i> Facial Recognition Enrollment <span class="required">*</span></h3>
        <div class="face-enroll-card" data-face-enrollment data-face-required="true">
          <input type="hidden" name="face_descriptor" data-face-hidden>
          <video data-face-video autoplay muted playsinline class="face-video"></video>
          <div class="face-actions">
            <button type="button" class="btn outline" data-face-start><i class="fas fa-video"></i> Start Camera</button>
            <button type="button" class="btn primary" data-face-capture><i class="fas fa-camera"></i> Capture Face</button>
            <button type="button" class="btn outline" data-face-clear><i class="fas fa-rotate-left"></i> Clear</button>
          </div>
          <div class="face-preview" data-face-preview><i class="fas fa-user"></i> Not enrolled</div>
          <small class="form-hint" data-face-status>Capture one clear front-facing face image in good light.</small>
        </div>

        <div class="form-actions">
          <a href="/teacher" class="btn outline"><i class="fas fa-times"></i> Cancel</a>
          <button type="submit" class="btn primary"><i class="fas fa-save"></i> Save Teacher</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
  (function () {
    'use strict';
    const form = document.getElementById('addTeacherForm');
    if (!form) return;

    function showErr(id, msg) {
      const el = document.getElementById(id);
      if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    }
    function clearErr(id) { showErr(id, ''); }

    function validateForm() {
      let ok = true;

      const name = (form.elements.name ? form.elements.name.value : '').trim();
      if (!name) { showErr('err-name', 'Full name is required.'); ok = false; }
      else if (name.length < 2) { showErr('err-name', 'Name must be at least 2 characters.'); ok = false; }
      else if (!/^[A-Za-z\s'\-\.]+$/.test(name)) { showErr('err-name', 'Name may only contain letters, spaces, hyphens, and apostrophes.'); ok = false; }
      else clearErr('err-name');

      if (!form.elements.subject.value) { showErr('err-subject', 'Please select a subject.'); ok = false; }
      else clearErr('err-subject');

      if (!form.elements.gender.value) { showErr('err-gender', 'Please select a gender.'); ok = false; }
      else clearErr('err-gender');

      const ec = (form.elements.teacher_id ? form.elements.teacher_id.value : '').trim();
      if (!ec) { showErr('err-ec', 'EC Number is required.'); ok = false; }
      else if (!/^[0-9]{7}[A-Za-z]$/.test(ec)) { showErr('err-ec', 'EC Number must be 7 digits followed by 1 letter (e.g. 1234567G).'); ok = false; }
      else clearErr('err-ec');

      const phone = (form.elements.phone ? form.elements.phone.value : '').trim();
      if (phone) {
        const digits = phone.replace(/[\s\-\(\)\.]/g, '');
        if (!/^\d{10}$/.test(digits)) { showErr('err-phone', 'Phone must be exactly 10 digits (e.g. 0712345678).'); ok = false; }
        else clearErr('err-phone');
      } else clearErr('err-phone');

      const email = (form.elements.email ? form.elements.email.value : '').trim();
      if (email) {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { showErr('err-email', 'Enter a valid email address.'); ok = false; }
        else clearErr('err-email');
      } else clearErr('err-email');

      return ok;
    }

    form.addEventListener('submit', function (e) {
      if (!validateForm()) {
        e.preventDefault();
        const firstErr = form.querySelector('.field-error[style*="block"]');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  })();
  </script>
  <script async src="https://docs.opencv.org/4.x/opencv.js" type="text/javascript"></script>
  <script src="/js/face-vision.js"></script>
  <script src="/vendor/tf.min.js"></script>
  <script src="/vendor/face-api.min.js"></script>
  <script src="/js/face-enrollment.js"></script>
  <style>
    .form-section-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--primary);
      margin: 1.25rem 0 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .required { color: var(--error, #e53e3e); margin-left: 2px; }
    .optional-label { font-size: 0.78rem; color: var(--text-muted); font-weight: 400; margin-left: 4px; }
    .field-error {
      display: none; color: var(--error, #e53e3e);
      font-size: 0.78rem; margin-top: 0.25rem; font-weight: 500;
    }
    .field-error::before { content: '\f071  '; font-family: 'Font Awesome 6 Free'; font-weight: 900; margin-right: 3px; }
    .face-enroll-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      background: var(--bg-secondary);
    }
    .face-video {
      width: 100%;
      max-width: 420px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #111827;
      display: block;
      margin-bottom: 0.75rem;
    }
    .face-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.75rem;
    }
    .face-preview {
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }
  </style>
</body>
</html>

