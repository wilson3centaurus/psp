<!DOCTYPE html> 
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Student | PSP</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/assets/logo.png">
</head>
<body class="form-page">
  <div class="form-page-container">
    <div class="form-page-header">
      <a href="/student" class="back-btn"><i class="fas fa-arrow-left"></i></a>
      <h1><i class="fas fa-user-plus"></i> Add New Student</h1>
      <button class="theme-toggle" aria-label="Toggle theme">
        <i class="fas fa-moon"></i>
        <i class="fas fa-sun"></i>
      </button>
    </div>

    <% if (typeof success_msg !== 'undefined' && success_msg && String(success_msg).trim() !== "") { %>
      <div class="alert success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg && String(error_msg).trim() !== "") { %>
      <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
    <% } %>

    <div class="card form-card">
      <form action="/student/add" method="POST" id="addStudentForm" novalidate>

        <!-- ── SECTION: Student Information ─────────────────── -->
        <h3 class="form-section-title"><i class="fas fa-user-graduate"></i> Student Information</h3>

        <div class="form-group">
          <label for="name"><i class="fas fa-user"></i> Full Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-input"
            placeholder="e.g. Tendai Moyo" required minlength="2" maxlength="100"
            pattern="[A-Za-z\s'\-\.]+" autocomplete="off">
          <small class="form-hint">Letters, spaces, hyphens, and apostrophes only.</small>
          <span class="field-error" id="err-name"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="grade"><i class="fas fa-layer-group"></i> Grade <span class="required">*</span></label>
            <select id="grade" name="grade" class="form-input" required>
              <option value="">Select Grade</option>
              <option value="1">Grade 1</option>
              <option value="2">Grade 2</option>
              <option value="3">Grade 3</option>
              <option value="4">Grade 4</option>
              <option value="5">Grade 5</option>
              <option value="6">Grade 6</option>
              <option value="7">Grade 7</option>
            </select>
            <span class="field-error" id="err-grade"></span>
          </div>
          <div class="form-group">
            <label for="student_class"><i class="fas fa-door-open"></i> Class <span class="required">*</span></label>
            <select id="student_class" name="student_class" class="form-input" required>
              <option value="">Select Class</option>
              <option value="A">Class A</option>
              <option value="B">Class B</option>
              <option value="C">Class C</option>
              <option value="D">Class D</option>
              <option value="E">Class E</option>
              <option value="F">Class F</option>
            </select>
            <span class="field-error" id="err-class"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="gender"><i class="fas fa-venus-mars"></i> Gender <span class="required">*</span></label>
            <select id="gender" name="gender" class="form-input" required>
              <option value="">Select Gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
            <span class="field-error" id="err-gender"></span>
          </div>
          <div class="form-group">
            <label><i class="fas fa-id-card"></i> Student ID</label>
            <div class="form-input read-only-field" style="background:var(--bg-secondary);color:var(--text-muted);cursor:default;">
              <i class="fas fa-magic" style="margin-right:6px;font-size:0.8em;"></i>Auto-generated on save
            </div>
            <small class="form-hint">A unique ID (e.g. PSP-2026-XK9F2M) is assigned automatically.</small>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="dob"><i class="fas fa-birthday-cake"></i> Date of Birth <span class="required">*</span></label>
            <input type="date" id="dob" name="dob" class="form-input" required
              max="<%= new Date(Date.now() - 5*365.25*24*60*60*1000).toISOString().split('T')[0] %>"
              min="<%= new Date(Date.now() - 18*365.25*24*60*60*1000).toISOString().split('T')[0] %>">
            <small class="form-hint">Student must be between 5 and 18 years old.</small>
            <span class="field-error" id="err-dob"></span>
          </div>
          <div class="form-group">
            <label for="enrollment_date"><i class="fas fa-calendar-check"></i> Enrollment Date <span class="required">*</span></label>
            <input type="date" id="enrollment_date" name="enrollment_date" class="form-input" required
              max="<%= new Date().toISOString().split('T')[0] %>"
              min="<%= new Date(Date.now() - 20*365.25*24*60*60*1000).toISOString().split('T')[0] %>">
            <small class="form-hint">The date the student was enrolled at this school.</small>
            <span class="field-error" id="err-enrollment"></span>
          </div>
        </div>

        <!-- ── SECTION: Parent / Guardian Information ─────────── -->
        <h3 class="form-section-title" style="margin-top:1.5rem;"><i class="fas fa-users"></i> Parent / Guardian Information <span class="optional-badge">Optional</span></h3>

        <div class="form-group">
          <label for="parent_name"><i class="fas fa-user-friends"></i> Parent / Guardian Name</label>
          <input type="text" id="parent_name" name="parent_name" class="form-input"
            placeholder="e.g. Mrs. Grace Moyo" maxlength="150" autocomplete="off">
          <span class="field-error" id="err-parent-name"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="parent_phone"><i class="fas fa-phone"></i> Parent Phone</label>
            <input type="tel" id="parent_phone" name="parent_phone" class="form-input"
              placeholder="e.g. 0712345678" maxlength="10" autocomplete="off">
            <small class="form-hint">Exactly 10 digits — no spaces, no +263 prefix (e.g. 0712345678)</small>
            <span class="field-error" id="err-parent-phone"></span>
          </div>
          <div class="form-group">
            <label for="parent_email"><i class="fas fa-envelope"></i> Parent Email</label>
            <input type="email" id="parent_email" name="parent_email" class="form-input"
              placeholder="e.g. grace.moyo@email.com" maxlength="100" autocomplete="off">
            <span class="field-error" id="err-parent-email"></span>
          </div>
        </div>

        <!-- ── SECTION: Additional Notes ─────────────────────── -->
        <div class="form-group" style="margin-top:0.5rem;">
          <label for="medical_notes"><i class="fas fa-notes-medical"></i> Medical / Special Notes</label>
          <textarea id="medical_notes" name="medical_notes" class="form-input" rows="3"
            placeholder="Any allergies, disabilities, or special requirements…" maxlength="1000"></textarea>
          <small class="form-hint">This information is kept confidential.</small>
          <span class="field-error" id="err-notes"></span>
        </div>

        <h3 id="face-enroll" class="form-section-title" style="margin-top:1.5rem;"><i class="fas fa-camera"></i> Facial Recognition Enrollment <span class="required">*</span></h3>
        <div class="face-step-banner">
          <div class="face-step-chip">Step 1</div>
          <div class="face-step-content">
            <strong>Start the camera and capture the student's face before saving.</strong>
            <p>This activates facial recognition for attendance. The Save Student button will not complete registration until a face is captured.</p>
          </div>
        </div>
        <div class="face-enroll-card" data-face-enrollment data-face-required="true">
          <input type="hidden" name="face_descriptor" data-face-hidden>
          <video data-face-video autoplay muted playsinline class="face-video"></video>
          <div class="face-actions">
            <button type="button" class="btn outline" data-face-start><i class="fas fa-video"></i> Start Camera</button>
            <button type="button" class="btn primary" data-face-capture><i class="fas fa-camera"></i> Capture Face</button>
            <button type="button" class="btn outline" data-face-clear><i class="fas fa-rotate-left"></i> Clear</button>
          </div>
          <div class="face-preview" data-face-preview><i class="fas fa-user"></i> Not enrolled</div>
          <small class="form-hint" data-face-status>Capture one clear front-facing face image in good light.</small>
        </div>

        <div class="form-actions">
          <a href="/student" class="btn outline"><i class="fas fa-times"></i> Cancel</a>
          <button type="submit" class="btn primary"><i class="fas fa-save"></i> Save Student With Face</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
  (function () {
    'use strict';

    const form = document.getElementById('addStudentForm');
    if (!form) return;

    // ── Email domain autocomplete ─────────────────────────────
    const EMAIL_DOMAINS = ['gmail.com','yahoo.com','yahoo.co.zw','hotmail.com','outlook.com','protonmail.com','icloud.com','live.com','school.ac.zw'];
    function setupEmailSuggest(inputId) {
      const inp = document.getElementById(inputId);
      if (!inp) return;
      const wrapper = document.createElement('div');
      wrapper.style.cssText = 'position:relative;';
      inp.parentNode.insertBefore(wrapper, inp);
      wrapper.appendChild(inp);
      const ul = document.createElement('ul');
      ul.style.cssText = 'position:absolute;top:calc(100% + 2px);left:0;right:0;background:var(--surface);border:1px solid var(--primary);border-radius:8px;z-index:999;list-style:none;margin:0;padding:4px 0;box-shadow:0 6px 18px rgba(0,0,0,.15);display:none;max-height:220px;overflow-y:auto;';
      wrapper.appendChild(ul);
      inp.addEventListener('input', function() {
        const val = this.value, at = val.indexOf('@');
        if (at < 0) { ul.style.display = 'none'; return; }
        const after = val.slice(at + 1).toLowerCase(), pre = val.slice(0, at + 1);
        const hits = after === '' ? EMAIL_DOMAINS : EMAIL_DOMAINS.filter(function(d){ return d.startsWith(after); });
        if (!hits.length) { ul.style.display = 'none'; return; }
        ul.innerHTML = '';
        hits.forEach(function(d) {
          const li = document.createElement('li');
          li.textContent = pre + d;
          li.style.cssText = 'padding:9px 14px;cursor:pointer;font-size:0.875rem;border-radius:4px;';
          li.addEventListener('mouseenter', function() { this.style.background = 'var(--bg-secondary)'; });
          li.addEventListener('mouseleave', function() { this.style.background = ''; });
          li.addEventListener('mousedown', function(e) {
            e.preventDefault(); inp.value = pre + d;
            ul.style.display = 'none';
          });
          ul.appendChild(li);
        });
        ul.style.display = 'block';
      });
      document.addEventListener('click', function(e) { if (!wrapper.contains(e.target)) ul.style.display = 'none'; });
    }
    setupEmailSuggest('parent_email');

    // ── Helpers ───────────────────────────────────────────────
    function showErr(id, msg) {
      const el = document.getElementById(id);
      if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    }
    function clearErr(id) { showErr(id, ''); }

    function ageFromDOB(dobStr) {
      if (!dobStr) return null;
      const birth = new Date(dobStr), today = new Date();
      let age = today.getFullYear() - birth.getFullYear();
      const m = today.getMonth() - birth.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
      return age;
    }

    function checkEmail(email) {
      if (!email) return null;
      if (email.length > 254) return 'Email is too long (max 254 characters).';
      const atCount = (email.match(/@/g) || []).length;
      if (atCount === 0) return 'Email must contain an @ symbol \u2014 e.g. name@gmail.com.';
      if (atCount > 1)  return 'Email must contain exactly one @ symbol.';
      const parts = email.split('@'), local = parts[0], domain = parts[1];
      if (!local) return 'Email must have a name before the @ symbol.';
      if (local.length > 64) return 'The part before @ is too long (max 64 characters).';
      if (/^[.\-_+]/.test(local)) return 'Email username cannot start with "' + local[0] + '" \u2014 remove it.';
      if (/[.\-_+]$/.test(local)) return 'Email username cannot end with "' + local[local.length-1] + '" \u2014 remove it.';
      if (/\.{2,}/.test(local)) return 'Email username cannot contain consecutive dots.';
      if (!/^[a-zA-Z0-9._%+\-]+$/.test(local)) return 'Email username has an invalid character. Only letters, numbers, dots, underscores and hyphens are allowed.';
      if (!domain) return 'Email must have a domain after the @ symbol \u2014 e.g. gmail.com.';
      if (!/^[a-zA-Z0-9.\-]+$/.test(domain)) return 'Email domain has an invalid character.';
      if (/^[-.]/.test(domain) || /[-.]$/.test(domain)) return 'Email domain cannot start or end with a hyphen or dot.';
      if (/\.{2,}/.test(domain)) return 'Email domain cannot contain consecutive dots.';
      if (!domain.includes('.')) return 'Email domain must include a TLD \u2014 e.g. @gmail.com, not just @gmail.';
      const tld = domain.split('.').pop();
      if (tld.length < 2) return 'Email extension is too short \u2014 use .com, .org, .zw etc.';
      if (tld.length > 6) return 'Email extension ".' + tld + '" is too long \u2014 use .com, .org, .zw.';
      if (!/^[a-zA-Z]+$/.test(tld)) return 'Email extension must contain only letters (e.g. .com, .org, .zw).';
      return null;
    }

    function validateForm() {
      let ok = true;

      // Full Name (required \u2014 first + last name)
      const name = (form.elements.name ? form.elements.name.value : '').trim();
      const nameWords = name.split(/\s+/).filter(function(w){ return w.length > 0; });
      if (!name) {
        showErr('err-name', 'Full name is required \u2014 enter first and last name.'); ok = false;
      } else if (!/^[A-Za-z\s\'\-\.]+$/.test(name)) {
        showErr('err-name', 'Name may only contain letters, spaces, hyphens and apostrophes \u2014 no numbers or symbols.'); ok = false;
      } else if (/\s{2,}/.test(name)) {
        showErr('err-name', 'Name cannot have two spaces in a row \u2014 remove the extra space.'); ok = false;
      } else if (nameWords.length < 2) {
        showErr('err-name', 'Please enter both first and last name (e.g. "Tendai Moyo").'); ok = false;
      } else if (nameWords.some(function(w){ return w.length < 2; })) {
        showErr('err-name', 'Each part of the name must be at least 2 letters long.'); ok = false;
      } else { clearErr('err-name'); }

      // Grade (required, 1-7)
      const gradeVal = form.elements.grade ? form.elements.grade.value : '';
      if (!gradeVal) {
        showErr('err-grade', 'Please select a grade \u2014 this field is required.'); ok = false;
      } else if (!['1','2','3','4','5','6','7'].includes(gradeVal)) {
        showErr('err-grade', 'Invalid grade selected \u2014 choose from Grade 1 to 7.'); ok = false;
      } else { clearErr('err-grade'); }

      // Class (required, A-F)
      const classVal = form.elements.student_class ? form.elements.student_class.value : '';
      if (!classVal) {
        showErr('err-class', 'Please select a class \u2014 this field is required.'); ok = false;
      } else if (!['A','B','C','D','E','F'].includes(classVal)) {
        showErr('err-class', 'Invalid class selected \u2014 choose from A to F.'); ok = false;
      } else { clearErr('err-class'); }

      // Gender (required)
      if (!form.elements.gender || !form.elements.gender.value) {
        showErr('err-gender', 'Please select a gender \u2014 this field is required.'); ok = false;
      } else if (!['Male','Female','Other'].includes(form.elements.gender.value)) {
        showErr('err-gender', 'Invalid gender selected.'); ok = false;
      } else { clearErr('err-gender'); }

      // Date of Birth (required, 3-20 years, not future)
      const dob = form.elements.dob ? form.elements.dob.value : '';
      if (!dob) {
        showErr('err-dob', 'Date of birth is required \u2014 this field cannot be left blank.'); ok = false;
      } else {
        const dobDate = new Date(dob);
        const today = new Date(); today.setHours(0,0,0,0);
        if (isNaN(dobDate.getTime())) {
          showErr('err-dob', 'Date of birth is not a valid date \u2014 please re-enter correctly.'); ok = false;
        } else if (dobDate >= today) {
          showErr('err-dob', 'Date of birth cannot be today or in the future.'); ok = false;
        } else {
          const age = ageFromDOB(dob);
          if (age < 3) {
            showErr('err-dob', 'Student is too young (age ' + age + ') \u2014 minimum enrollment age is 3 years.'); ok = false;
          } else if (age > 20) {
            showErr('err-dob', 'Student age (' + age + ') is too high \u2014 maximum is 20 years.'); ok = false;
          } else { clearErr('err-dob'); }
        }
      }

      // Enrollment Date (required, not future, \u22653 yrs after DOB, max 30 yrs ago)
      const enroll = form.elements.enrollment_date ? form.elements.enrollment_date.value : '';
      if (!enroll) {
        showErr('err-enrollment', 'Enrollment date is required \u2014 this field cannot be left blank.'); ok = false;
      } else {
        const enrollDate = new Date(enroll);
        const today = new Date(); today.setHours(0,0,0,0);
        const thirtyAgo = new Date(); thirtyAgo.setFullYear(thirtyAgo.getFullYear() - 30);
        if (isNaN(enrollDate.getTime())) {
          showErr('err-enrollment', 'Enrollment date is not a valid date \u2014 please re-enter correctly.'); ok = false;
        } else if (enrollDate > today) {
          showErr('err-enrollment', 'Enrollment date cannot be in the future.'); ok = false;
        } else if (enrollDate < thirtyAgo) {
          showErr('err-enrollment', 'Enrollment date cannot be more than 30 years in the past.'); ok = false;
        } else if (dob && !isNaN(new Date(dob).getTime())) {
          const diffYrs = (enrollDate - new Date(dob)) / (365.25 * 24 * 3600 * 1000);
          if (diffYrs < 3) {
            showErr('err-enrollment', 'Enrollment date must be at least 3 years after the date of birth.'); ok = false;
          } else { clearErr('err-enrollment'); }
        } else { clearErr('err-enrollment'); }
      }

      // Parent Name (optional \u2014 strict if filled)
      const pName = (form.elements.parent_name ? form.elements.parent_name.value : '').trim();
      if (pName) {
        const pWords = pName.split(/\s+/).filter(function(w){ return w.length > 0; });
        if (pName.length < 4) {
          showErr('err-parent-name', 'Parent name is too short \u2014 enter full name.'); ok = false;
        } else if (!/^[A-Za-z\s\'\-\.]+$/.test(pName)) {
          showErr('err-parent-name', 'Parent name may only contain letters, spaces, hyphens and apostrophes.'); ok = false;
        } else if (pWords.length < 2) {
          showErr('err-parent-name', 'Please enter parent\'s first and last name (e.g. "Mrs. Grace Moyo").'); ok = false;
        } else { clearErr('err-parent-name'); }
      } else { clearErr('err-parent-name'); }

      // Parent Phone (optional \u2014 exactly 10 digits if filled)
      const pPhone = (form.elements.parent_phone ? form.elements.parent_phone.value : '').trim();
      if (pPhone) {
        const digits = pPhone.replace(/[\s\-\(\)\.]/g, '');
        if (!/^\d{10}$/.test(digits)) {
          showErr('err-parent-phone', 'Phone must be exactly 10 digits (e.g. 0712345678) \u2014 no +263 prefix or spaces.'); ok = false;
        } else { clearErr('err-parent-phone'); }
      } else { clearErr('err-parent-phone'); }

      // Parent Email (optional \u2014 brutal validation if filled)
      const pEmail = (form.elements.parent_email ? form.elements.parent_email.value : '').trim();
      if (pEmail) {
        const emailErr = checkEmail(pEmail);
        if (emailErr) { showErr('err-parent-email', emailErr); ok = false; }
        else clearErr('err-parent-email');
      } else { clearErr('err-parent-email'); }

      // Medical Notes (optional \u2014 must be meaningful if filled)
      const notes = (form.elements.medical_notes ? form.elements.medical_notes.value : '').trim();
      if (notes && notes.length < 5) {
        showErr('err-notes', 'Medical notes must be at least 5 characters if provided \u2014 or leave blank.'); ok = false;
      } else if (notes && notes.length > 1000) {
        showErr('err-notes', 'Medical notes cannot exceed 1,000 characters.'); ok = false;
      } else { clearErr('err-notes'); }

      return ok;
    }

    form.addEventListener('submit', function (e) {
      if (!validateForm()) {
        e.preventDefault();
        const firstErr = form.querySelector('.field-error[style*="block"]');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Live validation on every field
    form.querySelectorAll('input, select, textarea').forEach(function(el) {
      el.addEventListener('blur', validateForm);
      el.addEventListener('change', validateForm);
    });
  })();
  </script>
        else clearErr('err-parent-email');
      } else clearErr('err-parent-email');

      return ok;
    }

    form.addEventListener('submit', function (e) {
      if (!validateForm()) {
        e.preventDefault();
        // Scroll to first error
        const firstErr = form.querySelector('.field-error[style*="block"]');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Live validation on blur
    ['name', 'student_id', 'dob', 'enrollment_date', 'parent_phone', 'parent_email'].forEach(function(fieldName) {
      const el = form.elements[fieldName];
      if (el) el.addEventListener('blur', function () { validateForm(); });
    });
  })();
  </script>
  <script async src="https://docs.opencv.org/4.x/opencv.js" type="text/javascript"></script>
  <script src="/js/face-vision.js"></script>
  <script src="/vendor/tf.min.js"></script>
  <script src="/vendor/face-api.min.js"></script>
  <script src="/js/face-enrollment.js"></script>
  <style>
    .form-section-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--primary);
      margin: 1.25rem 0 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .optional-badge {
      font-size: 0.72rem;
      font-weight: 500;
      background: var(--bg-secondary);
      color: var(--text-muted);
      padding: 0.1rem 0.5rem;
      border-radius: 20px;
      border: 1px solid var(--border);
      margin-left: 0.5rem;
    }
    .required { color: var(--error, #e53e3e); margin-left: 2px; }
    .field-error {
      display: none;
      color: var(--error, #e53e3e);
      font-size: 0.78rem;
      margin-top: 0.25rem;
      font-weight: 500;
    }
    .field-error::before { content: '\f071  '; font-family: 'Font Awesome 6 Free'; font-weight: 900; margin-right: 3px; }
    .face-enroll-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      background: var(--bg-secondary);
    }
    .face-step-banner {
      display: flex;
      gap: 0.85rem;
      align-items: flex-start;
      padding: 0.95rem 1rem;
      margin-bottom: 0.85rem;
      border-radius: 12px;
      border: 1px solid rgba(var(--primary-rgb), 0.28);
      background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.13), rgba(var(--primary-rgb), 0.05));
    }
    .face-step-chip {
      min-width: 60px;
      text-align: center;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      background: var(--primary);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 700;
    }
