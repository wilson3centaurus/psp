<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Student | PSP</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/assets/logo.png">
</head>
<body class="form-page">
  <div class="form-page-container">
    <div class="form-page-header">
      <a href="/student" class="back-btn"><i class="fas fa-arrow-left"></i></a>
      <h1><i class="fas fa-pen"></i> Edit Student</h1>
      <button class="theme-toggle" aria-label="Toggle theme">
        <i class="fas fa-moon"></i>
        <i class="fas fa-sun"></i>
      </button>
    </div>

    <% if (typeof success_msg !== 'undefined' && success_msg && String(success_msg).trim() !== "") { %>
      <div class="alert success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg && String(error_msg).trim() !== "") { %>
      <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
    <% } %>

    <div class="card form-card">
      <form action="/student/edit/<%= student.id %>" method="POST" id="editStudentForm" novalidate>

        <!-- ── SECTION: Student Information ─── -->
        <h3 class="form-section-title"><i class="fas fa-user-graduate"></i> Student Information</h3>

        <div class="form-group">
          <label for="name"><i class="fas fa-user"></i> Full Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-input" required
            value="<%= student.name %>" minlength="2" maxlength="100"
            pattern="[A-Za-z\s'\-\.]+" autocomplete="off">
          <small class="form-hint">Letters, spaces, hyphens, and apostrophes only.</small>
          <span class="field-error" id="err-name"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="grade"><i class="fas fa-layer-group"></i> Grade <span class="required">*</span></label>
            <select id="grade" name="grade" class="form-input" required>
              <option value="">Select Grade</option>
              <% [1,2,3,4,5,6,7].forEach(function(g){ %>
                <option value="<%= g %>" <%= String(student.grade) === String(g) ? 'selected' : '' %>>Grade <%= g %></option>
              <% }); %>
            </select>
            <span class="field-error" id="err-grade"></span>
          </div>
          <div class="form-group">
            <label for="student_class"><i class="fas fa-door-open"></i> Class <span class="required">*</span></label>
            <select id="student_class" name="student_class" class="form-input" required>
              <option value="">Select Class</option>
              <% ['A','B','C','D','E','F'].forEach(function(c){ %>
                <option value="<%= c %>" <%= student.student_class === c ? 'selected' : '' %>>Class <%= c %></option>
              <% }); %>
            </select>
            <span class="field-error" id="err-class"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="gender"><i class="fas fa-venus-mars"></i> Gender <span class="required">*</span></label>
            <select id="gender" name="gender" class="form-input" required>
              <option value="">Select Gender</option>
              <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= student.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
            <span class="field-error" id="err-gender"></span>
          </div>
          <div class="form-group">
            <label for="student_id"><i class="fas fa-id-card"></i> Student ID <span class="required">*</span></label>
            <input type="text" id="student_id" name="student_id" class="form-input" required
              value="<%= student.student_id %>" maxlength="50" autocomplete="off">
            <small class="form-hint">Alphanumeric, hyphens, and underscores only.</small>
            <span class="field-error" id="err-student-id"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="dob"><i class="fas fa-birthday-cake"></i> Date of Birth <span class="required">*</span></label>
            <input type="date" id="dob" name="dob" class="form-input" required
              value="<%= student.dob ? (student.dob instanceof Date ? student.dob.toISOString().split('T')[0] : String(student.dob).slice(0,10)) : '' %>"
              max="<%= new Date(Date.now() - 5*365.25*24*60*60*1000).toISOString().split('T')[0] %>"
              min="<%= new Date(Date.now() - 18*365.25*24*60*60*1000).toISOString().split('T')[0] %>">
            <small class="form-hint">Student must be between 5 and 18 years old.</small>
            <span class="field-error" id="err-dob"></span>
          </div>
          <div class="form-group">
            <label for="enrollment_date"><i class="fas fa-calendar-check"></i> Enrollment Date <span class="required">*</span></label>
            <input type="date" id="enrollment_date" name="enrollment_date" class="form-input" required
              value="<%= student.enrollment_date ? (student.enrollment_date instanceof Date ? student.enrollment_date.toISOString().split('T')[0] : String(student.enrollment_date).slice(0,10)) : '' %>"
              max="<%= new Date().toISOString().split('T')[0] %>"
              min="<%= new Date(Date.now() - 20*365.25*24*60*60*1000).toISOString().split('T')[0] %>">
            <span class="field-error" id="err-enrollment"></span>
          </div>
        </div>

        <!-- ── SECTION: Parent / Guardian ─── -->
        <h3 class="form-section-title" style="margin-top:1.5rem;"><i class="fas fa-users"></i> Parent / Guardian Information <span class="optional-badge">Optional</span></h3>

        <div class="form-group">
          <label for="parent_name"><i class="fas fa-user-friends"></i> Parent / Guardian Name</label>
          <input type="text" id="parent_name" name="parent_name" class="form-input"
            value="<%= student.parent_name || '' %>" maxlength="150" autocomplete="off">
          <span class="field-error" id="err-parent-name"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="parent_phone"><i class="fas fa-phone"></i> Parent Phone</label>
            <input type="tel" id="parent_phone" name="parent_phone" class="form-input"
              value="<%= student.parent_phone || '' %>" maxlength="30" placeholder="e.g. +263712345678">
            <small class="form-hint">Format: +263712345678 or 0712345678</small>
            <span class="field-error" id="err-parent-phone"></span>
          </div>
          <div class="form-group">
            <label for="parent_email"><i class="fas fa-envelope"></i> Parent Email</label>
            <input type="email" id="parent_email" name="parent_email" class="form-input"
              value="<%= student.parent_email || '' %>" maxlength="100">
            <span class="field-error" id="err-parent-email"></span>
          </div>
        </div>

        <!-- ── SECTION: Additional Notes ─── -->
        <div class="form-group" style="margin-top:0.5rem;">
          <label for="medical_notes"><i class="fas fa-notes-medical"></i> Medical / Special Notes</label>
          <textarea id="medical_notes" name="medical_notes" class="form-input" rows="3"
            maxlength="1000" placeholder="Any allergies, disabilities, or special requirements…"><%= student.medical_notes || '' %></textarea>
          <small class="form-hint">This information is kept confidential.</small>
        </div>

        <h3 id="face-enroll" class="form-section-title" style="margin-top:1.5rem;"><i class="fas fa-camera"></i> Facial Recognition Enrollment</h3>
        <div class="face-step-banner">
          <div class="face-step-chip">Face</div>
          <div class="face-step-content">
            <strong><%= student.face_descriptor ? 'This student already has a saved face profile.' : 'This student does not have a face profile yet.' %></strong>
            <p><%= student.face_descriptor ? 'Use the buttons below only if you want to replace the current face used for attendance.' : 'Start the camera and capture a face now to enable facial-recognition attendance for this student.' %></p>
          </div>
        </div>
        <div class="face-enroll-card" data-face-enrollment data-face-required="false">
          <input type="hidden" name="face_descriptor" data-face-hidden>
          <video data-face-video autoplay muted playsinline class="face-video"></video>
          <div class="face-actions">
            <button type="button" class="btn outline" data-face-start><i class="fas fa-video"></i> Start Camera</button>
            <button type="button" class="btn primary" data-face-capture><i class="fas fa-camera"></i> Capture New Face</button>
            <button type="button" class="btn outline" data-face-clear><i class="fas fa-rotate-left"></i> Clear</button>
          </div>
          <div class="face-preview" data-face-preview><i class="fas fa-user-check"></i> Keep existing face unless recaptured</div>
          <small class="form-hint" data-face-status>Capture only if you want to replace this student's current enrolled face.</small>
        </div>

        <div class="form-actions">
          <a href="/student" class="btn outline"><i class="fas fa-times"></i> Cancel</a>
          <button type="submit" class="btn primary"><i class="fas fa-save"></i> Update Student</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
  (function () {
    'use strict';
    const form = document.getElementById('editStudentForm');
    if (!form) return;

    function showErr(id, msg) {
      const el = document.getElementById(id);
      if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    }
    function clearErr(id) { showErr(id, ''); }

    function ageFromDOB(dobStr) {
      if (!dobStr) return null;
      const birth = new Date(dobStr);
      const today = new Date();
      let age = today.getFullYear() - birth.getFullYear();
      const m = today.getMonth() - birth.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
      return age;
    }

    function validateForm() {
      let ok = true;

      const name = (form.elements.name ? form.elements.name.value : '').trim();
      if (!name) { showErr('err-name', 'Full name is required.'); ok = false; }
      else if (name.length < 2) { showErr('err-name', 'Name must be at least 2 characters.'); ok = false; }
      else if (!/^[A-Za-z\s'\-\.]+$/.test(name)) { showErr('err-name', 'Name may only contain letters, spaces, hyphens, and apostrophes.'); ok = false; }
      else clearErr('err-name');

      if (!form.elements.grade.value) { showErr('err-grade', 'Please select a grade.'); ok = false; }
      else clearErr('err-grade');

      if (!form.elements.student_class.value) { showErr('err-class', 'Please select a class.'); ok = false; }
      else clearErr('err-class');

      if (!form.elements.gender.value) { showErr('err-gender', 'Please select a gender.'); ok = false; }
      else clearErr('err-gender');

      const sid = (form.elements.student_id ? form.elements.student_id.value : '').trim();
      if (!sid) { showErr('err-student-id', 'Student ID is required.'); ok = false; }
      else if (!/^[A-Za-z0-9\-_\/]+$/.test(sid)) { showErr('err-student-id', 'Student ID may only contain letters, numbers, hyphens, and underscores.'); ok = false; }
      else clearErr('err-student-id');

      const dob = form.elements.dob ? form.elements.dob.value : '';
      if (!dob) { showErr('err-dob', 'Date of birth is required.'); ok = false; }
      else {
        const age = ageFromDOB(dob);
        if (age === null || isNaN(age)) { showErr('err-dob', 'Please enter a valid date.'); ok = false; }
        else if (age < 5) { showErr('err-dob', 'Student must be at least 5 years old.'); ok = false; }
        else if (age > 18) { showErr('err-dob', `Age ${age} exceeds the maximum of 18 for primary school.`); ok = false; }
        else if (new Date(dob) > new Date()) { showErr('err-dob', 'Date of birth cannot be in the future.'); ok = false; }
        else clearErr('err-dob');
      }

      const enroll = form.elements.enrollment_date ? form.elements.enrollment_date.value : '';
      if (!enroll) { showErr('err-enrollment', 'Enrollment date is required.'); ok = false; }
      else if (new Date(enroll) > new Date()) { showErr('err-enrollment', 'Enrollment date cannot be in the future.'); ok = false; }
      else clearErr('err-enrollment');

      const pPhone = (form.elements.parent_phone ? form.elements.parent_phone.value : '').trim();
      if (pPhone) {
        const digits = pPhone.replace(/[\s\-\(\)\.]/g, '');
        if (!/^\+?[0-9]{7,15}$/.test(digits)) { showErr('err-parent-phone', 'Enter a valid phone number.'); ok = false; }
        else clearErr('err-parent-phone');
      } else clearErr('err-parent-phone');

      const pEmail = (form.elements.parent_email ? form.elements.parent_email.value : '').trim();
      if (pEmail) {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(pEmail)) { showErr('err-parent-email', 'Enter a valid email address.'); ok = false; }
        else clearErr('err-parent-email');
      } else clearErr('err-parent-email');

      return ok;
    }

    form.addEventListener('submit', function (e) {
      if (!validateForm()) {
        e.preventDefault();
        const firstErr = form.querySelector('.field-error[style*="block"]');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  })();
  </script>
  <script async src="https://docs.opencv.org/4.x/opencv.js" type="text/javascript"></script>
  <script src="/js/face-vision.js"></script>
  <script src="/vendor/tf.min.js"></script>
  <script src="/vendor/face-api.min.js"></script>
  <script src="/js/face-enrollment.js"></script>
  <style>
    .form-section-title {
      font-size: 0.95rem; font-weight: 600; color: var(--primary);
      margin: 1.25rem 0 0.75rem; padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 0.4rem;
    }
    .optional-badge {
      font-size: 0.72rem; font-weight: 500;
      background: var(--bg-secondary); color: var(--text-muted);
      padding: 0.1rem 0.5rem; border-radius: 20px;
      border: 1px solid var(--border); margin-left: 0.5rem;
    }
    .required { color: var(--error, #e53e3e); margin-left: 2px; }
    .field-error {
      display: none; color: var(--error, #e53e3e);
      font-size: 0.78rem; margin-top: 0.25rem; font-weight: 500;
    }
    .field-error::before { content: '\f071  '; font-family: 'Font Awesome 6 Free'; font-weight: 900; margin-right: 3px; }
    .face-enroll-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      background: var(--bg-secondary);
    }
    .face-step-banner {
      display: flex;
      gap: 0.85rem;
      align-items: flex-start;
      padding: 0.95rem 1rem;
      margin-bottom: 0.85rem;
      border-radius: 12px;
      border: 1px solid rgba(var(--primary-rgb), 0.28);
      background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.13), rgba(var(--primary-rgb), 0.05));
    }
    .face-step-chip {
      min-width: 60px;
      text-align: center;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      background: var(--primary);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 700;
    }
    .face-step-content p {
      margin: 0.25rem 0 0;
      font-size: 0.84rem;
      color: var(--text-secondary);
    }
    .face-video {
      width: 100%;
      max-width: 420px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #111827;
      display: block;
      margin-bottom: 0.75rem;
    }
    .face-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.75rem;
    }
    .face-preview {
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }
  </style>
</body>
</html>

