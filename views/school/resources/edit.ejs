<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Resource | PSP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/assets/logo.png">
</head>
<body class="form-page">
  <div class="form-page-container">
    <div class="form-page-header">
      <a href="/resources" class="back-btn"><i class="fas fa-arrow-left"></i></a>
      <h1><i class="fas fa-edit"></i> Edit Resource</h1>
      <button class="theme-toggle" aria-label="Toggle theme">
        <i class="fas fa-moon"></i>
        <i class="fas fa-sun"></i>
      </button>
    </div>

    <div class="card form-card">
      <% if (typeof success_msg !== 'undefined' && success_msg && String(success_msg).trim() !== "") { %>
        <div class="alert success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
      <% } %>
      <% if (typeof error_msg !== 'undefined' && error_msg && String(error_msg).trim() !== "") { %>
        <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
      <% } %>

      <form action="/resources/edit/<%= resource.id %>" method="POST" id="editResourceForm" novalidate>
        <!-- Subject Information -->
        <div class="form-section">
          <h3 class="form-section-title"><i class="fas fa-book-open"></i> Subject Information</h3>
          <div class="form-row">
            <div class="form-group">
              <label for="subject_name"><i class="fas fa-book"></i> Subject</label>
              <select name="subject_name" id="subject_name" class="form-input" required>
                <option value="">Select Subject</option>
                <option value="Mathematics" <%= resource.subject_name === 'Mathematics' ? 'selected' : '' %>>Mathematics</option>
                <option value="English" <%= resource.subject_name === 'English' ? 'selected' : '' %>>English</option>
                <option value="Chishona" <%= resource.subject_name === 'Chishona' ? 'selected' : '' %>>Chishona</option>
                <option value="Social Science" <%= resource.subject_name === 'Social Science' ? 'selected' : '' %>>Social Science</option>
                <option value="Physical Education and Arts" <%= resource.subject_name === 'Physical Education and Arts' ? 'selected' : '' %>>Physical Education and Arts</option>
                <option value="Science and Technology" <%= resource.subject_name === 'Science and Technology' ? 'selected' : '' %>>Science and Technology</option>
              </select>
              <span class="field-error" id="err-subject"></span>
            </div>
            <div class="form-group">
              <label for="subject_id"><i class="fas fa-id-badge"></i> Subject ID</label>
              <input type="text" name="subject_id" id="subject_id" class="form-input" value="<%= resource.subject_id %>" maxlength="20" required>
              <small class="form-hint">2–20 characters — letters, numbers, hyphens only (e.g. MATH-01)</small>
              <span class="field-error" id="err-subject-id"></span>
            </div>
          </div>

          <div class="form-group">
            <label for="grade"><i class="fas fa-graduation-cap"></i> Grade</label>
            <select name="grade" id="grade" class="form-input" required>
              <option value="">Select Grade</option>
              <option value="Grade 1" <%= resource.grade === 'Grade 1' ? 'selected' : '' %>>Grade 1</option>
              <option value="Grade 2" <%= resource.grade === 'Grade 2' ? 'selected' : '' %>>Grade 2</option>
              <option value="Grade 3" <%= resource.grade === 'Grade 3' ? 'selected' : '' %>>Grade 3</option>
              <option value="Grade 4" <%= resource.grade === 'Grade 4' ? 'selected' : '' %>>Grade 4</option>
              <option value="Grade 5" <%= resource.grade === 'Grade 5' ? 'selected' : '' %>>Grade 5</option>
              <option value="Grade 6" <%= resource.grade === 'Grade 6' ? 'selected' : '' %>>Grade 6</option>
              <option value="Grade 7" <%= resource.grade === 'Grade 7' ? 'selected' : '' %>>Grade 7</option>
            </select>
            <span class="field-error" id="err-grade"></span>
          </div>
        </div>

        <!-- Student Count -->
        <div class="form-section">
          <h3 class="form-section-title"><i class="fas fa-users"></i> Class Information</h3>
          <div class="form-group">
            <label for="num_students"><i class="fas fa-user-graduate"></i> Number of Students</label>
            <input type="number" name="num_students" id="num_students" class="form-input" min="0" max="5000" value="<%= resource.num_students %>" required>
            <small class="form-hint"><i class="fas fa-info-circle"></i> Total students enrolled in this subject/grade (0–5,000)</small>
            <span class="field-error" id="err-students"></span>
          </div>
        </div>

        <!-- Learning Materials -->
        <div class="form-section">
          <h3 class="form-section-title"><i class="fas fa-book"></i> Learning Materials</h3>
          <div class="form-group">
            <label for="num_books"><i class="fas fa-book-open"></i> Total Books</label>
            <input type="number" name="num_books" id="num_books" class="form-input" min="0" max="50000" value="<%= resource.num_books %>" required>
            <small class="form-hint">Total textbooks/workbooks available (0–50,000)</small>
            <span class="field-error" id="err-books"></span>
          </div>
        </div>

        <!-- Technology Resources -->
        <div class="form-section">
          <h3 class="form-section-title"><i class="fas fa-laptop"></i> Technology Resources</h3>
          <div class="form-group">
            <label for="num_computers"><i class="fas fa-desktop"></i> Total Computers/Devices</label>
            <input type="number" name="num_computers" id="num_computers" class="form-input" min="0" max="5000" value="<%= resource.num_computers %>" required>
            <small class="form-hint">Total computers/tablets/devices (0–5,000)</small>
            <span class="field-error" id="err-computers"></span>
          </div>
        </div>

        <!-- Resource Ratio Indicator -->
        <div class="form-section">
          <h3 class="form-section-title"><i class="fas fa-chart-bar"></i> Resource Ratios</h3>
          <div class="ratio-indicators">
            <div class="ratio-card" id="book-ratio-card">
              <div class="ratio-icon"><i class="fas fa-book"></i></div>
              <div class="ratio-info">
                <span class="ratio-label">Books per Student</span>
                <span class="ratio-value" id="book-ratio">0:0</span>
              </div>
            </div>
            <div class="ratio-card" id="computer-ratio-card">
              <div class="ratio-icon"><i class="fas fa-laptop"></i></div>
              <div class="ratio-info">
                <span class="ratio-label">Students per Computer</span>
                <span class="ratio-value" id="computer-ratio">0:0</span>
              </div>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <a href="/resources" class="btn outline"><i class="fas fa-times"></i> Cancel</a>
          <button type="submit" class="btn primary"><i class="fas fa-save"></i> Update Resource</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
  (function() {
    'use strict';
    var form = document.getElementById('editResourceForm');
    if (!form) return;

    function showErr(id, msg) {
      var el = document.getElementById(id);
      if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    }
    function clearErr(id) { showErr(id, ''); }

    function validateForm() {
      var ok = true;

      // Subject (required)
      if (!form.elements.subject_name || !form.elements.subject_name.value) {
        showErr('err-subject', 'Please select a subject \u2014 this field is required.'); ok = false;
      } else { clearErr('err-subject'); }

      // Subject ID (required, 2-20, alphanumeric/hyphens)
      var sid = (form.elements.subject_id ? form.elements.subject_id.value : '').trim();
      if (!sid) {
        showErr('err-subject-id', 'Subject ID is required \u2014 this field cannot be blank.'); ok = false;
      } else if (sid.length < 2) {
        showErr('err-subject-id', 'Subject ID must be at least 2 characters.'); ok = false;
      } else if (sid.length > 20) {
        showErr('err-subject-id', 'Subject ID must not exceed 20 characters.'); ok = false;
      } else if (!/^[A-Za-z0-9\-_]+$/.test(sid)) {
        showErr('err-subject-id', 'Subject ID may only contain letters, numbers, hyphens and underscores (e.g. MATH-01).'); ok = false;
      } else { clearErr('err-subject-id'); }

      // Grade (required)
      if (!form.elements.grade || !form.elements.grade.value) {
        showErr('err-grade', 'Please select a grade \u2014 this field is required.'); ok = false;
      } else { clearErr('err-grade'); }

      // Number of students (required, 0-5000)
      var stuVal = form.elements.num_students ? form.elements.num_students.value : '';
      var students = parseInt(stuVal, 10);
      if (stuVal === '' || isNaN(students)) {
        showErr('err-students', 'Number of students is required \u2014 enter 0 if none.'); ok = false;
      } else if (students < 0) {
        showErr('err-students', 'Number of students cannot be negative.'); ok = false;
      } else if (students > 5000) {
        showErr('err-students', 'Number of students cannot exceed 5,000 per class record.'); ok = false;
      } else { clearErr('err-students'); }

      // Number of books (required, 0-50000)
      var bookVal = form.elements.num_books ? form.elements.num_books.value : '';
      var books = parseInt(bookVal, 10);
      if (bookVal === '' || isNaN(books)) {
        showErr('err-books', 'Total books is required \u2014 enter 0 if none.'); ok = false;
      } else if (books < 0) {
        showErr('err-books', 'Total books cannot be negative.'); ok = false;
      } else if (books > 50000) {
        showErr('err-books', 'Total books cannot exceed 50,000.'); ok = false;
      } else { clearErr('err-books'); }

      // Number of computers (required, 0-5000)
      var compVal = form.elements.num_computers ? form.elements.num_computers.value : '';
      var comps = parseInt(compVal, 10);
      if (compVal === '' || isNaN(comps)) {
        showErr('err-computers', 'Total computers/devices is required \u2014 enter 0 if none.'); ok = false;
      } else if (comps < 0) {
        showErr('err-computers', 'Total computers cannot be negative.'); ok = false;
      } else if (comps > 5000) {
        showErr('err-computers', 'Total computers cannot exceed 5,000.'); ok = false;
      } else { clearErr('err-computers'); }

      return ok;
    }

    form.addEventListener('submit', function(e) {
      if (!validateForm()) {
        e.preventDefault();
        var firstErr = form.querySelector('[id^="err-"][style*="block"]');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    form.querySelectorAll('input, select').forEach(function(el) {
      el.addEventListener('blur', validateForm);
      el.addEventListener('change', validateForm);
    });
  })();
  </script>
  <script>
    // Update ratio indicators
    function updateRatios() {
      const students = parseInt(document.getElementById('num_students').value) || 0;
      const books = parseInt(document.getElementById('num_books').value) || 0;
      const computers = parseInt(document.getElementById('num_computers').value) || 0;

      // Book ratio
      const bookRatioEl = document.getElementById('book-ratio');
      const bookRatioCard = document.getElementById('book-ratio-card');
      if (students > 0 && books > 0) {
        const ratio = (books / students).toFixed(1);
        bookRatioEl.textContent = ratio + ':1';
        bookRatioCard.className = 'ratio-card ' + (ratio >= 1 ? 'good' : ratio >= 0.5 ? 'warning' : 'bad');
      } else {
        bookRatioEl.textContent = '0:0';
        bookRatioCard.className = 'ratio-card';
      }

      // Computer ratio
      const compRatioEl = document.getElementById('computer-ratio');
      const compRatioCard = document.getElementById('computer-ratio-card');
      if (students > 0 && computers > 0) {
        const ratio = Math.ceil(students / computers);
        compRatioEl.textContent = ratio + ':1';
        compRatioCard.className = 'ratio-card ' + (ratio <= 5 ? 'good' : ratio <= 10 ? 'warning' : 'bad');
      } else {
        compRatioEl.textContent = '0:0';
        compRatioCard.className = 'ratio-card';
      }
    }

    // Add event listeners for ratio updates
    document.getElementById('num_students').addEventListener('input', updateRatios);
    document.getElementById('num_books').addEventListener('input', updateRatios);
    document.getElementById('num_computers').addEventListener('input', updateRatios);
    
    // Initial calculation
    updateRatios();
  </script>
</body>
</html>
