<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Attendance Register | PSP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="<%= typeof schoolLogo !== 'undefined' && schoolLogo ? '/uploads/' + schoolLogo : '/assets/logo.png' %>">
  <style>
    /* ── Stats row ─────────────────────────────────────────── */
    .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.75rem; margin-bottom:1.25rem; }
    @media(max-width:700px){ .stats-grid{ grid-template-columns:repeat(2,1fr); } }
    .stat-card { background:var(--surface); border:2px solid var(--border); border-radius:var(--radius-lg);
      padding:1rem; display:flex; flex-direction:column; gap:.35rem; }
    .stat-card.present { border-color:#22c55e; background:rgba(34,197,94,.06); }
    .stat-card.absent  { border-color:#ef4444; background:rgba(239,68,68,.06); }
    .stat-card.late    { border-color:#f59e0b; background:rgba(245,158,11,.06); }
    .stat-label { font-size:.78rem; color:var(--text-secondary); display:flex; align-items:center; gap:.4rem; }
    .stat-value { font-size:1.9rem; font-weight:800; color:var(--text-primary); line-height:1; }
    .stat-card.present .stat-value { color:#22c55e; }
    .stat-card.absent  .stat-value { color:#ef4444; }
    .stat-card.late    .stat-value { color:#f59e0b; }

    /* ── Controls bar ──────────────────────────────────────── */
    .att-controls { display:flex; gap:.75rem; align-items:flex-end; flex-wrap:wrap; margin-bottom:1rem; }
    .att-controls .form-group { flex:1; min-width:180px; }
    .att-controls label { font-size:.78rem; margin-bottom:.25rem; display:block; }

    /* ── Main two-column layout ────────────────────────────── */
    .att-layout { display:grid; grid-template-columns:minmax(280px,420px) 1fr; gap:1rem; align-items:start; }
    @media(max-width:900px){ .att-layout{ grid-template-columns:1fr; } }

    /* ── Camera panel ──────────────────────────────────────── */
    .camera-panel { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; }
    .camera-panel-header { padding:.75rem 1rem; border-bottom:1px solid var(--border);
      display:flex; align-items:center; gap:.5rem; font-weight:600; font-size:.9rem; }
    .camera-panel-body { padding:1rem; }
    .face-video { width:100%; border-radius:10px; border:1px solid var(--border);
      background:#0f172a; display:block; min-height:200px; }
    .camera-btns { display:flex; gap:.5rem; margin-top:.75rem; flex-wrap:wrap; }
    #face-status { display:block; padding:.45rem .7rem; border-radius:8px; margin-top:.6rem;
      font-size:.8rem; font-weight:500; background:rgba(0,0,0,.06); }
    #face-status[data-state="ok"]   { background:rgba(34,197,94,.12); color:#15803d; }
    #face-status[data-state="error"]{ background:rgba(239,68,68,.12); color:#b91c1c; }
    #face-status[data-state="warn"] { background:rgba(245,158,11,.12); color:#92400e; }
    .face-events { font-size:.78rem; margin-top:.6rem; max-height:180px; overflow-y:auto; display:grid; gap:.3rem; }
    .face-event { padding:.3rem .5rem; border:1px solid var(--border); border-radius:6px;
      background:var(--bg-secondary); color:var(--text-secondary); }

    /* ── Roster panel ──────────────────────────────────────── */
    .roster-panel { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; }
    .roster-header { padding:.75rem 1rem; border-bottom:1px solid var(--border);
      display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; }
    .roster-title { font-weight:600; font-size:.9rem; display:flex; align-items:center; gap:.5rem; }
    .roster-actions { display:flex; gap:.5rem; }
    .roster-list { max-height:520px; overflow-y:auto; }
    .roster-item {
      display:flex; align-items:center; gap:.75rem;
      padding:.65rem 1rem; border-bottom:1px solid var(--border);
      transition:background .2s;
    }
    .roster-item:last-child { border-bottom:none; }
    .roster-item.is-present { background:rgba(34,197,94,.08); }
    .roster-item.is-absent  { background:rgba(239,68,68,.06); }
    .roster-item.is-late    { background:rgba(245,158,11,.07); }
    .roster-num { font-size:.72rem; color:var(--text-muted); width:24px; flex-shrink:0; text-align:right; }
    .roster-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; background:#ef4444; transition:background .3s; }
    .roster-item.is-present .roster-dot { background:#22c55e; }
    .roster-item.is-late    .roster-dot { background:#f59e0b; }
    .roster-name { flex:1; font-size:.88rem; font-weight:500; }
    .roster-face-icon { font-size:.72rem; color:var(--text-muted); margin-top:.1rem; }
    .roster-face-icon.enrolled { color:#15803d; }
    .roster-btns { display:flex; gap:.3rem; flex-shrink:0; }
    .mini-btn { padding:.28rem .55rem; border-radius:6px; border:1px solid var(--border);
      background:var(--bg-secondary); font-size:.72rem; cursor:pointer; font-weight:600;
      transition:all .15s; line-height:1; }
    .mini-btn.p { color:#15803d; } .mini-btn.p:hover,.mini-btn.p.on { background:#22c55e; color:#fff; border-color:#22c55e; }
    .mini-btn.a { color:#b91c1c; } .mini-btn.a:hover,.mini-btn.a.on { background:#ef4444; color:#fff; border-color:#ef4444; }
    .mini-btn.l { color:#92400e; } .mini-btn.l:hover,.mini-btn.l.on { background:#f59e0b; color:#fff; border-color:#f59e0b; }

    /* ── Progress bar ──────────────────────────────────────── */
    .progress-wrap { margin:.75rem 0; }
    .progress-bar { height:6px; background:var(--bg-secondary); border-radius:99px; overflow:hidden; }
    .progress-fill { height:100%; background:linear-gradient(90deg,#22c55e,#4ade80); border-radius:99px; transition:width .3s; }
    .progress-label { font-size:.75rem; color:var(--text-muted); text-align:right; margin-top:.25rem; }

    /* ── Save button ───────────────────────────────────────── */
    .save-section { padding:1rem; border-top:1px solid var(--border); }
  </style>
</head>
<body>
  <div class="app-shell">
    <div class="sidebar-overlay"></div>
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-brand">
          <img src="<%= typeof schoolLogo !== 'undefined' && schoolLogo ? '/uploads/' + schoolLogo : '/assets/logo.png' %>" alt="Logo" class="sidebar-logo">
          <div>
            <div class="sidebar-brand-text"><%= typeof schoolDisplayName !== 'undefined' && schoolDisplayName ? schoolDisplayName : user.username %></div>
            <div class="sidebar-brand-label">School Portal</div>
          </div>
        </div>
      </div>
      <nav class="sidebar-nav">
        <div class="nav-section">
          <div class="nav-section-title">Main</div>
          <a class="nav-link" href="/school/dashboard"><i class="fas fa-gauge-high"></i> Dashboard</a>
        </div>
        <div class="nav-section">
          <div class="nav-section-title">Management</div>
          <a class="nav-link" href="/student"><i class="fas fa-user-graduate"></i> Students</a>
          <a class="nav-link" href="/teacher"><i class="fas fa-chalkboard-user"></i> Teachers</a>
          <a class="nav-link" href="/resources"><i class="fas fa-boxes-stacked"></i> Resources</a>
        </div>
        <div class="nav-section">
          <div class="nav-section-title">Attendance</div>
          <a class="nav-link active" href="/student-attendance"><i class="fas fa-clipboard-user"></i> Student Attendance</a>
          <a class="nav-link" href="/teacher-attendance"><i class="fas fa-user-clock"></i> Teacher Attendance</a>
        </div>
        <div class="nav-section">
          <div class="nav-section-title">Account</div>
          <a class="nav-link logout" href="/logout"><i class="fas fa-right-from-bracket"></i> Logout</a>
        </div>
      </nav>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-menu-btn" aria-label="Toggle menu"><i class="fas fa-bars"></i></button>
          <button onclick="history.back()" title="Go back" class="topbar-back"><i class="fas fa-arrow-left"></i></button>
          <span class="page-title">Attendance Register</span>
        </div>
        <div class="topbar-right">
          <button class="theme-toggle" aria-label="Toggle theme">
            <i class="fas fa-moon"></i><i class="fas fa-sun"></i>
          </button>
          <a href="/student-attendance" class="topbar-btn"><i class="fas fa-calendar"></i><span>Sessions</span></a>
          <a href="/logout" class="topbar-btn danger"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
        </div>
      </header>

      <section class="content">
        <% if (success_msg && String(success_msg).trim()) { %>
          <div class="alert success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
        <% } %>
        <% if (error_msg && String(error_msg).trim()) { %>
          <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
        <% } %>

        <!-- Stats -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label"><i class="fas fa-users"></i> Total</div>
            <div class="stat-value" id="total-count"><%= students ? students.length : 0 %></div>
          </div>
          <div class="stat-card present">
            <div class="stat-label"><i class="fas fa-check-circle"></i> Present</div>
            <div class="stat-value" id="present-count">0</div>
          </div>
          <div class="stat-card absent">
            <div class="stat-label"><i class="fas fa-times-circle"></i> Absent</div>
            <div class="stat-value" id="absent-count">0</div>
          </div>
          <div class="stat-card late">
            <div class="stat-label"><i class="fas fa-clock"></i> Late</div>
            <div class="stat-value" id="late-count">0</div>
          </div>
        </div>

        <!-- Controls -->
        <div class="att-controls">
          <div class="form-group">
            <label>Select Class</label>
            <select id="class-selector" class="form-input" onchange="loadClass()">
              <option value="">-- Select a class --</option>
              <% if (typeof allClasses !== 'undefined' && allClasses.length > 0) { %>
                <% allClasses.forEach(c => { %>
                  <option value="<%= c.grade %>|<%= c.student_class %>"
                    <%= (selectedGrade === String(c.grade) && selectedClass === c.student_class) ? 'selected' : '' %>>
                    Grade <%= c.grade %> <%= c.student_class %> (<%= c.count %> students)
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label>Date</label>
            <input type="date" id="attendance-date" class="form-input" value="<%= selectedDate || '' %>">
          </div>
        </div>

        <% if (students && students.length > 0) { %>
          <% const enrolledCount = students.filter(s => s.face_descriptor).length; %>

          <!-- Progress -->
          <div class="progress-wrap">
            <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
            <div class="progress-label"><span id="marked-count">0</span> / <%= students.length %> marked &nbsp;·&nbsp; <span id="progress-pct">0%</span></div>
          </div>

          <!-- Two-column layout: Camera | Roster -->
          <div class="att-layout">

            <!-- ── Camera Panel ── -->
            <div class="camera-panel">
              <div class="camera-panel-header">
                <i class="fas fa-camera" style="color:var(--primary)"></i>
                Face Scanner
                <span style="margin-left:auto;font-size:.75rem;font-weight:400;color:var(--text-muted);">
                  <%= enrolledCount %>/<%= students.length %> enrolled
                </span>
              </div>
              <div class="camera-panel-body">
                <video id="face-video" class="face-video" autoplay muted playsinline></video>
                <div class="camera-btns">
                  <button type="button" id="start-face-scan" class="btn primary">
                    <i class="fas fa-video"></i> Start Scanner
                  </button>
                  <button type="button" id="stop-face-scan" class="btn outline" disabled>
                    <i class="fas fa-stop"></i> Stop
                  </button>
                </div>
                <small id="face-status">Scanner idle. Select a class and click Start.</small>
                <div id="face-events" class="face-events"></div>
              </div>
            </div>

            <!-- ── Roster Panel ── -->
            <div class="roster-panel">
              <div class="roster-header">
                <div class="roster-title">
                  <i class="fas fa-list-check" style="color:var(--primary)"></i>
                  Student Roster
                </div>
                <div class="roster-actions">
                  <button type="button" class="mini-btn p" onclick="markAll('Present')" title="Mark all present">
                    <i class="fas fa-check-double"></i> All Present
                  </button>
                  <button type="button" class="mini-btn a" onclick="markAll('Absent')" title="Mark all absent">
                    <i class="fas fa-user-xmark"></i> All Absent
                  </button>
                </div>
              </div>

              <form id="attendance-form" method="POST" action="/student-attendance/mark">
                <input type="hidden" name="grade" value="<%= selectedGrade %>">
                <input type="hidden" name="student_class" value="<%= selectedClass %>">
                <input type="hidden" name="date" id="form-date" value="<%= selectedDate %>">

                <div class="roster-list" id="roster-list">
                  <% students.forEach((student, idx) => { %>
                    <% const initStatus = ['Present','Late','Absent'].includes(student.attendance_status) ? student.attendance_status : 'Absent'; %>
                    <div class="roster-item is-<%= initStatus.toLowerCase() %>" id="row-<%= student.id %>">
                      <span class="roster-num"><%= String(idx+1).padStart(2,'0') %></span>
                      <span class="roster-dot"></span>
                      <div style="flex:1;min-width:0;">
                        <div class="roster-name"><%= student.name %></div>
                        <div class="roster-face-icon <%= student.face_descriptor ? 'enrolled' : '' %>">
                          <% if (student.face_descriptor) { %>
                            <i class="fas fa-face-smile"></i> Face enrolled
                          <% } else { %>
                            <i class="fas fa-triangle-exclamation"></i> No face
                          <% } %>
                        </div>
                      </div>
                      <div class="roster-btns">
                        <button type="button" class="mini-btn p <%= initStatus==='Present'?'on':'' %>" onclick="setStatus(<%= student.id %>,'Present')" title="Present">P</button>
                        <button type="button" class="mini-btn l <%= initStatus==='Late'?'on':'' %>"    onclick="setStatus(<%= student.id %>,'Late')"    title="Late">L</button>
                        <button type="button" class="mini-btn a <%= initStatus==='Absent'?'on':'' %>"  onclick="setStatus(<%= student.id %>,'Absent')"  title="Absent">A</button>
                      </div>
                      <input type="hidden" name="status_<%= student.id %>" id="status-<%= student.id %>" value="<%= initStatus %>">
                      <input type="hidden" name="reason_<%= student.id %>" id="reason-<%= student.id %>" value="<%= student.attendance_reason || '' %>">
                    </div>
                  <% }) %>
                </div>

                <div class="save-section">
                  <button type="submit" class="btn primary" style="width:100%;">
                    <i class="fas fa-save"></i> Save Attendance Session
                  </button>
                </div>
              </form>
            </div>
          </div>

        <% } else { %>
          <div class="card" style="text-align:center;padding:3rem;color:var(--text-muted);">
            <i class="fas fa-users" style="font-size:3rem;opacity:.3;display:block;margin-bottom:1rem;"></i>
            <p>Select a class above to start marking attendance.</p>
          </div>
        <% } %>
      </section>

      <footer class="footer">
        <p>&copy; 2026 Primary School Performance System | made with <i class="fas fa-heart"></i> by Memory Nikisi</p>
      </footer>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script>
  // ── Date init ─────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    const d = document.getElementById('attendance-date');
    if (d && !d.value) {
      const now = new Date();
      d.value = now.getFullYear() + '-' +
        String(now.getMonth()+1).padStart(2,'0') + '-' +
        String(now.getDate()).padStart(2,'0');
    }
    if (d) d.addEventListener('change', function () {
      const fd = document.getElementById('form-date');
      if (fd) fd.value = this.value;
    });
    if (document.getElementById('form-date') && d) {
      document.getElementById('form-date').value = d.value;
    }
    updateStats();
  });

  function loadClass() {
    const sel = document.getElementById('class-selector');
    const d = document.getElementById('attendance-date');
    if (!sel.value) return;
    const [grade, cls] = sel.value.split('|');
    const date = (d && d.value) || new Date().toISOString().split('T')[0];
    window.location.href = '/student-attendance/mark?grade=' + encodeURIComponent(grade) +
      '&class=' + encodeURIComponent(cls) + '&date=' + date;
  }

  // ── Status helpers ────────────────────────────────────────────────────────
  function setStatus(studentId, status) {
    const hidden = document.getElementById('status-' + studentId);
    if (hidden) hidden.value = status;

    const row = document.getElementById('row-' + studentId);
    if (row) {
      row.className = 'roster-item is-' + status.toLowerCase();
      row.querySelectorAll('.mini-btn').forEach(b => b.classList.remove('on'));
      const map = { Present: 'p', Late: 'l', Absent: 'a' };
      const target = row.querySelector('.mini-btn.' + (map[status] || 'a'));
      if (target) target.classList.add('on');
    }
    updateStats();
  }

  function markAll(status) {
    document.querySelectorAll('[id^="status-"]').forEach(function (input) {
      const id = input.id.replace('status-', '');
      setStatus(id, status);
    });
  }

  function updateStats() {
    let present = 0, absent = 0, late = 0;
    document.querySelectorAll('[id^="status-"]').forEach(function (inp) {
      if (inp.value === 'Present') present++;
      else if (inp.value === 'Late') late++;
      else absent++;
    });
    document.getElementById('present-count').textContent = present;
    document.getElementById('absent-count').textContent  = absent;
    document.getElementById('late-count').textContent    = late;

    const total = parseInt(document.getElementById('total-count').textContent) || 0;
    const marked = present + absent + late;
    document.getElementById('marked-count').textContent = marked;
    const pct = total ? Math.round(marked/total*100) : 0;
    document.getElementById('progress-pct').textContent = pct + '%';
    document.getElementById('progress-fill').style.width = pct + '%';
  }

  // ── Face recognition profiles & callback ──────────────────────────────────
  window.PSP_FACE_PROFILES = <%- JSON.stringify((students || []).filter(s => s.face_descriptor).map(s => ({ id: s.id, name: s.name, descriptor: s.face_descriptor }))) %>;

  window.PSPFaceAttendance_onRecognized = async function (studentId, name, distance) {
    // Flash the row green immediately
    const row = document.getElementById('row-' + studentId);
    if (row) {
      row.style.transition = 'box-shadow .3s';
      row.style.boxShadow = '0 0 0 3px #22c55e';
      setTimeout(() => { row.style.boxShadow = ''; }, 1800);
    }

    // Save via API
    const date = document.getElementById('attendance-date')?.value || '';
    const resp = await fetch('/student-attendance/face-mark', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        studentId,
        grade: <%- JSON.stringify(selectedGrade || '') %>,
        studentClass: <%- JSON.stringify(selectedClass || '') %>,
        date
      })
    });
    const data = await resp.json();
    if (!resp.ok || !data.ok) {
      const err = new Error(data.message || 'Failed to save attendance');
      err.studentId = studentId;
      throw err;
    }

    // Update UI
    setStatus(studentId, 'Present');
    const reason = document.getElementById('reason-' + studentId);
    if (reason) reason.value = 'Face recognition';
    updateStats();
  };
  </script>

  <script src="/vendor/tf.min.js"></script>
  <script src="/vendor/face-api.min.js"></script>
  <script src="/js/face-attendance.js"></script>
</body>
</html>
